{% if product %}
<div
  class="booking-widget"
  data-booking-widget
  data-product-id="gid://shopify/Product/{{ product.id }}"
  data-proxy-base="/apps/booking"
  data-unit-price="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}"
  data-currency-code="{{ cart.currency.iso_code | default: shop.currency }}"
  data-country="{{ localization.country.iso_code }}"
  data-tick-icon="{{ 'tick.svg' | asset_url }}"
  data-calendar-icon="{{ 'calendar.svg' | asset_url }}"
>
  <div class="booking-widget__cart-reminder" data-booking-cart-reminder hidden>
    <p class="booking-widget__cart-reminder-title" data-booking-cart-reminder-title></p>
    <ul class="booking-widget__cart-reminder-list" data-booking-cart-reminder-list></ul>
  </div>

  <div class="booking-widget__selection" data-booking-selection hidden></div>

  <button type="button" class="button button--secondary button--full-width booking-widget__trigger" data-booking-trigger hidden>Book your slot</button>
  <p class="booking-widget__unavailable" data-booking-unavailable hidden></p>
  <p class="booking-widget__multi-add-status" data-booking-multi-add-status hidden></p>
  <p class="booking-widget__error" data-booking-error hidden></p>

  <!-- Popup modal -->
  <div class="booking-widget__overlay" data-booking-overlay hidden>
    <div class="booking-widget__modal" role="dialog" aria-modal="true" aria-label="Book Your Spot">
      <div class="booking-widget__modal-header">
        <h2 class="booking-widget__modal-title">Book Your Spot</h2>
        <button type="button" class="booking-widget__close" data-booking-close aria-label="Close">&times;</button>
      </div>

      <div class="booking-widget__modal-banner" data-booking-modal-banner>
        <img
          class="booking-widget__modal-banner-image"
          src="{{ 'storebanner.svg' | asset_url }}"
          alt="Book your spot"
          width="740"
          height="141"
          fetchpriority="high"
          decoding="async"
          onload="this.classList.add('is-loaded')"
        >
      </div>

      <div class="booking-widget__modal-body" data-booking-modal-body>
        <div class="booking-widget__location-step" data-booking-location-step hidden>
          <div class="booking-widget__location-field">
            <span class="booking-widget__location-icon" aria-hidden="true">
              <img src="{{ 'location.svg' | asset_url }}" alt="" width="30" height="30" decoding="async">
            </span>
            <label class="booking-widget__location-static-label" id="booking-widget-location-label">Add Location</label>
            <div class="booking-widget__location-select-wrap">
              <div
                class="booking-widget__location-trigger"
                data-booking-location-trigger
                role="button"
                tabindex="0"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="booking-widget-location-list-{{ product.id }}"
                aria-labelledby="booking-widget-location-label"
              >
                <span class="booking-widget__location-trigger-text" data-booking-location-trigger-text>Select location</span>
                <span class="booking-widget__location-chevron" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 8L9.3 12.2C9.61 12.51 9.77 12.66 9.95 12.69C10.06 12.71 10.19 12.71 10.3 12.69C10.48 12.66 10.64 12.51 10.95 12.2L15.25 8" stroke="#073E74" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
              <ul
                class="booking-widget__location-list"
                id="booking-widget-location-list-{{ product.id }}"
                data-booking-location-list
                role="listbox"
                aria-labelledby="booking-widget-location-label"
                hidden
              ></ul>
            </div>
          </div>
          <p class="booking-widget__location-error" data-booking-location-error hidden></p>
        </div>

        <div class="booking-widget__datetime-step" data-booking-datetime-step hidden>
          <div class="booking-widget__bundle-progress" data-booking-bundle-progress hidden>
            <p class="booking-widget__bundle-progress-label" data-booking-bundle-progress-label></p>
            <div class="booking-widget__bundle-progress-bar">
              <div class="booking-widget__bundle-progress-fill" data-booking-bundle-progress-fill></div>
            </div>
          </div>

          <div class="booking-widget__range-summary" data-booking-range-summary hidden>
            <p class="booking-widget__range-hint" data-booking-range-hint></p>
            <div class="booking-widget__selected-dates" data-booking-selected-dates hidden>
              <p class="booking-widget__selected-dates-label" data-booking-selected-dates-label></p>
              <div class="booking-widget__selected-dates-badge">
                <span class="booking-widget__selected-dates-text" data-booking-selected-dates-text></span>
                <button type="button" class="booking-widget__selected-dates-clear" data-booking-selected-dates-clear aria-label="Clear selected dates">&times;</button>
              </div>
            </div>
          </div>

          <div class="booking-widget__datetime-card" data-booking-datetime-card>
            <div class="booking-widget__calendar-pane" data-booking-calendar-pane>
              <div class="booking-widget__calendar" data-booking-calendar>
                <p class="booking-widget__status" data-booking-status>
                  Loading availability…
                </p>
              </div>
            </div>

            <div class="booking-widget__slots-pane" data-booking-slots-pane hidden>
              <div class="booking-widget__duration" data-booking-duration hidden></div>
              <div class="booking-widget__slots" data-booking-slots>
                <div class="booking-widget__slots-heading">
                  <span class="booking-widget__slots-heading-icon" aria-hidden="true">
              <img src="{{ 'clock.svg' | asset_url }}" alt="" width="30" height="30" decoding="async">
            </span>
                  <p class="booking-widget__slots-label">Select Time Slot</p>
                </div>
                <div class="booking-widget__slot-list" data-booking-slot-list>
                  <p class="booking-widget__status">Select a date to see available times.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="booking-widget__datetime-extras" data-booking-datetime-extras>
            <div class="booking-widget__quantity" data-booking-quantity>
              <span class="booking-widget__quantity-icon" aria-hidden="true">
              <img src="{{ 'quantity.svg' | asset_url }}" alt="" width="30" height="29" decoding="async">
            </span>
              <p class="booking-widget__quantity-label">Quantity</p>
              <div class="booking-widget__quantity-control">
                <button
                  type="button"
                  class="booking-widget__quantity-btn"
                  data-booking-quantity-decrease
                  aria-label="Decrease quantity"
                  disabled
                >&minus;</button>
                <input
                  type="number"
                  inputmode="numeric"
                  min="1"
                  step="1"
                  value="1"
                  class="booking-widget__quantity-input"
                  id="booking-widget-quantity-{{ product.id }}"
                  data-booking-quantity-input
                  aria-label="Quantity"
                  disabled
                >
                <button
                  type="button"
                  class="booking-widget__quantity-btn"
                  data-booking-quantity-increase
                  aria-label="Increase quantity"
                  disabled
                >+</button>
              </div>
            </div>

            <div class="booking-widget__note" data-booking-note>
              <span class="booking-widget__note-icon" aria-hidden="true">
              <img src="{{ 'note.svg' | asset_url }}" alt="" width="28" height="28" decoding="async">
            </span>
              <p class="booking-widget__note-label" data-booking-note-label>Note</p>
              <input
                type="text"
                class="booking-widget__note-input"
                id="booking-widget-note-{{ product.id }}"
                data-booking-note-input
                placeholder="Enter Your Request"
                aria-label="Note"
                disabled
              >
            </div>
          </div>

          <div class="booking-widget__custom-fields booking-widget__custom-fields--entry" data-booking-custom-fields-entry hidden></div>
        </div>
      </div>

      <div class="booking-widget__review-body" data-booking-review-body hidden>
        <div class="booking-widget__review-step" data-booking-review-step hidden>
          <div class="booking-widget__review-header">
            <p class="booking-widget__review-title">Review Your Bookings</p>
          </div>
          <dl class="booking-widget__review-list" data-booking-review-list></dl>
        </div>
      </div>

      <div class="booking-widget__modal-footer" data-booking-modal-footer>
        <button type="button" class="booking-widget__btn booking-widget__btn--confirm booking-widget__btn--back" data-booking-review-back hidden>
          Back
        </button>
        <div class="booking-widget__footer-actions">
          <button type="button" class="booking-widget__btn booking-widget__btn--secondary" data-booking-next-slot hidden disabled>
            Next Slot
          </button>
          <button type="button" class="booking-widget__btn booking-widget__btn--confirm" data-booking-confirm disabled>
            Confirm
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
{{ 'booking-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'booking-widget.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Booking Widget",
  "target": "body",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}