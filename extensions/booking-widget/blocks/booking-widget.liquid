<div
  class="booking-widget"
  data-booking-widget
  data-product-id="gid://shopify/Product/{{ product.id }}"
  data-proxy-base="/apps/booking"
  data-locale="{{ request.locale.iso_code }}"
  data-i18n-loading-availability="{{ 'booking_widget.loading_availability' | t }}"
  data-i18n-availability-error="{{ 'booking_widget.availability_error' | t }}"
  data-i18n-no-availability="{{ 'booking_widget.no_availability' | t }}"
  data-i18n-loading-times="{{ 'booking_widget.loading_times' | t }}"
  data-i18n-times-error="{{ 'booking_widget.times_error' | t }}"
  data-i18n-no-times="{{ 'booking_widget.no_times' | t }}"
  data-i18n-booked="{{ 'booking_widget.booked' | t }}"
  data-i18n-spot-left="{{ 'booking_widget.spot_left' | t }}"
  data-i18n-spots-left="{{ 'booking_widget.spots_left' | t }}"
  data-i18n-select-before-cart="{{ 'booking_widget.select_before_cart' | t }}"
  data-i18n-selected="{{ 'booking_widget.selected' | t }}"
  data-i18n-trigger-book="{{ 'booking_widget.trigger_book' | t }}"
  data-i18n-modal-title="{{ 'booking_widget.modal_title' | t }}"
  data-i18n-modal-subtitle="{{ 'booking_widget.modal_subtitle' | t }}"
  data-i18n-confirm="{{ 'booking_widget.confirm' | t }}"
  data-i18n-close="{{ 'booking_widget.close' | t }}"
  data-i18n-duration-minutes="{{ 'booking_widget.duration_minutes' | t }}"
  data-i18n-previous-month="{{ 'booking_widget.previous_month' | t }}"
  data-i18n-next-month="{{ 'booking_widget.next_month' | t }}"
  data-i18n-available-times="{{ 'booking_widget.available_times' | t }}"
>
  <p class="booking-widget__selection" data-booking-selection hidden></p>
  <button type="button" class="booking-widget__trigger" data-booking-trigger>{{ 'booking_widget.trigger_book' | t }}</button>
  <p class="booking-widget__error" data-booking-error hidden></p>

  <!-- Popup modal -->
  <div class="booking-widget__overlay" data-booking-overlay hidden>
    <div class="booking-widget__modal" role="dialog" aria-modal="true" aria-label="{{ 'booking_widget.modal_title' | t }}">
      <div class="booking-widget__modal-header">
        <h2 class="booking-widget__modal-title">{{ 'booking_widget.modal_title' | t }}</h2>
        <button type="button" class="booking-widget__close" data-booking-close aria-label="{{ 'booking_widget.close' | t }}">&times;</button>
      </div>

      <div class="booking-widget__modal-subheader">
        <p class="booking-widget__modal-subtitle">{{ 'booking_widget.modal_subtitle' | t }}</p>
        <span class="booking-widget__timezone" data-booking-timezone></span>
      </div>

      <div class="booking-widget__modal-body">
        <div class="booking-widget__calendar-pane">
          <div class="booking-widget__header">
            <button type="button" class="booking-widget__nav" data-booking-prev aria-label="{{ 'booking_widget.previous_month' | t }}">&lsaquo;</button>
            <span class="booking-widget__month-label" data-booking-month-label></span>
            <button type="button" class="booking-widget__nav" data-booking-next aria-label="{{ 'booking_widget.next_month' | t }}">&rsaquo;</button>
          </div>
          <div class="booking-widget__weekdays" data-booking-weekdays></div>
          <div class="booking-widget__calendar" data-booking-calendar>
            <p class="booking-widget__status" data-booking-status>
              {{ 'booking_widget.loading_availability' | t }}
            </p>
          </div>
        </div>

        <div class="booking-widget__slots-pane">
          <div class="booking-widget__duration" data-booking-duration hidden></div>
          <div class="booking-widget__slots" data-booking-slots>
            <p class="booking-widget__slots-label">{{ 'booking_widget.available_times' | t }}</p>
            <div class="booking-widget__slot-list" data-booking-slot-list>
              <p class="booking-widget__status">{{ 'booking_widget.no_times' | t }}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="booking-widget__modal-footer">
        <button type="button" class="booking-widget__btn booking-widget__btn--confirm" data-booking-confirm disabled>
          {{ 'booking_widget.confirm' | t }}
        </button>
      </div>
    </div>
  </div>
</div>

{{ 'booking-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'booking-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:booking_widget.block_name",
  "target": "section",
  "settings": []
}
{% endschema %}