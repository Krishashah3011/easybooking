{% if product %}
<div
  class="booking-widget"
  data-booking-widget
  data-product-id="gid://shopify/Product/{{ product.id }}"
  data-proxy-base="/apps/booking"
>
  <div class="booking-widget__cart-reminder" data-booking-cart-reminder hidden>
    <p class="booking-widget__cart-reminder-title" data-booking-cart-reminder-title></p>
    <ul class="booking-widget__cart-reminder-list" data-booking-cart-reminder-list></ul>
  </div>

  <div class="booking-widget__selection" data-booking-selection hidden></div>
  <button type="button" class="button button--secondary button--full-width booking-widget__trigger" data-booking-trigger>Book your slot</button>
  <p class="booking-widget__multi-add-status" data-booking-multi-add-status hidden></p>
  <p class="booking-widget__error" data-booking-error hidden></p>

  <!-- Popup modal -->
  <div class="booking-widget__overlay" data-booking-overlay hidden>
    <div class="booking-widget__modal" role="dialog" aria-modal="true" aria-label="Appointment - Booking">
      <div class="booking-widget__modal-header">
        <h2 class="booking-widget__modal-title">Appointment - Booking</h2>
        <button type="button" class="booking-widget__close" data-booking-close aria-label="Close">&times;</button>
      </div>

      <div class="booking-widget__modal-subheader">
        <p class="booking-widget__modal-subtitle">Select your preferred date &amp; time</p>
        <span class="booking-widget__timezone" data-booking-timezone></span>
      </div>

      <div class="booking-widget__modal-body" data-booking-modal-body>
        <div class="booking-widget__location-step" data-booking-location-step hidden>
          <label class="booking-widget__location-label" id="booking-widget-location-label">Select location</label>
          <div class="booking-widget__location-combobox" data-booking-location-combobox>
            <button
              type="button"
              class="booking-widget__location-trigger"
              data-booking-location-trigger
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-labelledby="booking-widget-location-label"
            >
              <span class="booking-widget__location-pin" aria-hidden="true">&#128205;</span>
              <span class="booking-widget__location-trigger-text" data-booking-location-trigger-text>Select location</span>
              <span class="booking-widget__location-chevron" data-booking-location-chevron aria-hidden="true">&#9662;</span>
            </button>
            <ul class="booking-widget__location-list" data-booking-location-list role="listbox" hidden></ul>
          </div>
          <p class="booking-widget__location-error" data-booking-location-error hidden></p>
        </div>

        <div class="booking-widget__datetime-step" data-booking-datetime-step>
          <button
            type="button"
            class="booking-widget__location-summary"
            data-booking-location-summary
            hidden
          >
            <span class="booking-widget__location-pin" aria-hidden="true">&#128205;</span>
            <span class="booking-widget__location-summary-text" data-booking-location-summary-text></span>
            <span class="booking-widget__location-chevron" aria-hidden="true">&#9662;</span>
          </button>

          <div class="booking-widget__calendar-pane">
            <div class="booking-widget__header">
              <button type="button" class="booking-widget__nav" data-booking-prev aria-label="Previous month">&lsaquo;</button>
              <span class="booking-widget__month-label" data-booking-month-label></span>
              <button type="button" class="booking-widget__nav" data-booking-next aria-label="Next month">&rsaquo;</button>
            </div>
            <div class="booking-widget__weekdays" data-booking-weekdays></div>
            <div class="booking-widget__calendar" data-booking-calendar>
              <p class="booking-widget__status" data-booking-status>
                Loading availability…
              </p>
            </div>
          </div>

          <div class="booking-widget__slots-pane">
            <div class="booking-widget__duration" data-booking-duration hidden></div>
            <div class="booking-widget__slots" data-booking-slots>
              <p class="booking-widget__slots-label">Available times</p>
              <div class="booking-widget__slot-list" data-booking-slot-list>
                <p class="booking-widget__status">No times available on this date.</p>
              </div>
            </div>

            <div class="booking-widget__quantity" data-booking-quantity hidden>
              <label class="booking-widget__quantity-label" for="booking-widget-quantity-{{ product.id }}">
                Quantity
              </label>
              <div class="booking-widget__quantity-control">
                <button
                  type="button"
                  class="booking-widget__quantity-btn"
                  data-booking-quantity-decrease
                  aria-label="Decrease quantity"
                >&minus;</button>
                <input
                  type="number"
                  inputmode="numeric"
                  min="1"
                  step="1"
                  value="1"
                  class="booking-widget__quantity-input"
                  id="booking-widget-quantity-{{ product.id }}"
                  data-booking-quantity-input
                >
                <button
                  type="button"
                  class="booking-widget__quantity-btn"
                  data-booking-quantity-increase
                  aria-label="Increase quantity"
                >+</button>
              </div>
              <p class="booking-widget__quantity-note" data-booking-quantity-note hidden></p>
            </div>
          </div>
        </div>
      </div>

      <div class="booking-widget__ask-more" data-booking-ask-more hidden>
        <p class="booking-widget__ask-more-message" data-booking-ask-more-message></p>
        <div class="booking-widget__ask-more-actions">
          <button type="button" class="booking-widget__btn booking-widget__btn--secondary" data-booking-ask-more-no>
            No, I'm done
          </button>
          <button type="button" class="booking-widget__btn booking-widget__btn--confirm" data-booking-ask-more-yes>
            Yes, add another slot
          </button>
        </div>
      </div>

      {% render 'booking-widget-custom-fields' %}

      <div class="booking-widget__modal-footer" data-booking-modal-footer>
        <button type="button" class="booking-widget__btn booking-widget__btn--confirm" data-booking-location-next hidden>
          Next
        </button>
        <button type="button" class="booking-widget__btn booking-widget__btn--confirm" data-booking-confirm disabled>
          Confirm
        </button>
      </div>
    </div>
  </div>
</div>

{{ 'booking-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'booking-widget.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Booking Widget",
  "target": "body",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}