generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model BookingSettings {
  id String @id @default(cuid())
  shop String @unique
  workingDays String @default("1,2,3,4,5")
  dailyStartTime String @default("09:00")
  dailyEndTime   String @default("17:00")
  slotDurationMinutes Int @default(30)
  bufferMinutes Int @default(0)
  minAdvanceHours Int @default(0)
  maxAdvanceDays Int @default(30)
  maxBookingsPerSlot Int @default(1)
  bookingStartDate DateTime?
  bookingEndDate   DateTime?
  emailFromName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingLocation {
  id String @id @default(cuid())
  shop String
  name String
  isEnabled Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, name])
  @@index([shop])
}

model BookableProduct {
  id String @id @default(cuid())
  shop String
  productId String
  productTitle String
  isEnabled Boolean @default(false)
  workingDays          String?
  dailyStartTime       String?
  dailyEndTime         String?
  slotDurationMinutes  Int?
  bufferMinutes        Int?
  minAdvanceHours      Int?
  maxAdvanceDays       Int?
  maxBookingsPerSlot   Int?
  bookingStartDate     DateTime?
  bookingEndDate       DateTime?
  blackoutDates BlackoutDate[]
  bookings      Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, productId])
  @@index([shop])
}

model BlackoutDate {
  id String @id @default(cuid())
  shop String
  bookableProductId String?
  bookableProduct   BookableProduct? @relation(fields: [bookableProductId], references: [id], onDelete: Cascade)
  date   DateTime
  reason String?
  createdAt DateTime @default(now())
  @@index([shop])
  @@index([bookableProductId])
}

enum BookingStatus {
  CONFIRMED
  OVERBOOKED
  CANCELLED
  /// Set when an admin reschedules a booking. Treated as fully active
  /// everywhere CONFIRMED is (counts toward slot capacity, still gets
  /// reminder emails) — it's a history label, not a distinct lifecycle state.
  RESCHEDULED
}

enum BookingSource {
  STOREFRONT_ORDER
  ADMIN_MANUAL
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
}

model CustomBookingField {
  id String @id @default(cuid())
  shop String
  fieldKey String
  label    String
  type     CustomFieldType @default(TEXT)
  required Boolean @default(false)
  options String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, fieldKey])
  @@index([shop])
}

model Booking {
  id String @id @default(cuid())
  shop String
  bookableProductId String
  bookableProduct   BookableProduct @relation(fields: [bookableProductId], references: [id], onDelete: Cascade)
  orderId       String?
  orderName     String?
  lineItemId    String?
  customerName  String?
  customerEmail String?
  customerPhone String?
  isGuest       Boolean @default(true)
  location     String?
  date         String
  slotStart    String
  slotEnd      String
  slotStartsAt DateTime
  status BookingStatus @default(CONFIRMED)
  source BookingSource
  customFieldResponses Json?
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shop])
  @@index([bookableProductId, slotStartsAt])
  @@index([orderId])
  @@index([status, reminderSentAt, slotStartsAt])
}