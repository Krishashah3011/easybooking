generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model BookingSettings {
  id String @id @default(cuid())
  shop String @unique
  workingDays String @default("1,2,3,4,5")
  dailyStartTime String @default("09:00")
  dailyEndTime   String @default("17:00")
  slotDurationMinutes Int @default(30)
  bufferMinutes Int @default(0)
  minAdvanceHours Int @default(0)
  maxAdvanceDays Int @default(30)
  maxBookingsPerSlot Int @default(1)
  bookingStartDate DateTime?
  bookingEndDate   DateTime?
  emailFromName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingLocation {
  id String @id @default(cuid())
  shop String
  name String
  timezone String @default("UTC")
  isEnabled Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, name])
  @@index([shop])
}

enum BookingType {
  SLOT
  FULL_DAY
  MULTI_DAY
  BUNDLE
}

model BookableProduct {
  id String @id @default(cuid())
  shop String
  productId String
  productTitle String
  isEnabled Boolean @default(false)
  bookingType BookingType @default(SLOT)
  workingDays          String?
  dailyStartTime       String?
  dailyEndTime         String?
  slotDurationMinutes  Int?
  bufferMinutes        Int?
  minAdvanceHours      Int?
  maxAdvanceDays       Int?
  maxBookingsPerSlot   Int?
  bookingStartDate     DateTime?
  bookingEndDate       DateTime?
  // MULTI_DAY only (date-range bookings, e.g. hotel rooms / rentals)
  minNights            Int?
  maxNights            Int?
  // BUNDLE only (a pack of sessions sold as one purchase)
  bundleSessionCount        Int?
  bundleSessionDurationMinutes Int?
  bundleValidityDays        Int?
  blackoutDates BlackoutDate[]
  bookings      Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, productId])
  @@index([shop])
}

model BlackoutDate {
  id String @id @default(cuid())
  shop String
  bookableProductId String?
  bookableProduct   BookableProduct? @relation(fields: [bookableProductId], references: [id], onDelete: Cascade)
  date   DateTime
  reason String?
  createdAt DateTime @default(now())
  @@index([shop])
  @@index([bookableProductId])
}

enum BookingStatus {
  CONFIRMED
  OVERBOOKED
  CANCELLED
  RESCHEDULED
}

enum BookingSource {
  STOREFRONT_ORDER
  ADMIN_MANUAL
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
}

model CustomBookingField {
  id String @id @default(cuid())
  shop String
  fieldKey String
  label    String
  type     CustomFieldType @default(TEXT)
  required Boolean @default(false)
  options String?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shop, fieldKey])
  @@index([shop])
}

model Booking {
  id String @id @default(cuid())
  shop String
  bookableProductId String
  bookableProduct   BookableProduct @relation(fields: [bookableProductId], references: [id], onDelete: Cascade)
  orderId       String?
  orderName     String?
  lineItemId    String?
  groupId       String?
  customerName  String?
  customerEmail String?
  customerPhone String?
  isGuest       Boolean @default(true)
  location     String?
  date         String
  endDate      String?
  slotStart    String
  slotEnd      String
  slotStartsAt DateTime
  slotEndsAt   DateTime?
  quantity Int @default(1)
  status BookingStatus @default(CONFIRMED)
  source BookingSource
  customFieldResponses Json?
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shop])
  @@index([bookableProductId, slotStartsAt])
  @@index([orderId])
  @@index([groupId])
  @@index([status, reminderSentAt, slotStartsAt])
}

model SmtpSettings {
  id        String   @id @default(cuid())
  shop      String   @unique
  host      String?
  port      Int?
  username  String?
  password  String?
  fromEmail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShopSettings {
  id            String   @id @default(cuid())
  shop          String   @unique
  registered    Boolean  @default(false)
  username      String?
  accountEmail  String?
  plan          String?
  subscriptionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}